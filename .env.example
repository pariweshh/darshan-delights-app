# Darshan Delights Mobile — Environment Variables Example
#
# IMPORTANT: In Expo, EXPO_PUBLIC_* variables are INLINED BY METRO at bundle build time.
# Whatever environment is loaded when the JS bundle is built is permanently baked into that bundle,
# including bundles shipped over OTA updates (eas update).

# -----------------------------------------------------------------------------
# 1. Local Development (.env file in repo root - gitignored)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_API_URL_DEV=https://admino.darshandelights.com.au
# EXPO_PUBLIC_API_URL_DEV=http://192.168.1.121:1337

# -----------------------------------------------------------------------------
# 2. Production Environment (EAS Server-Side Environment / Prod OTA)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_ENV=production
# EXPO_PUBLIC_API_URL_PROD=https://admino.darshandelights.com.au
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# EXPO_PUBLIC_APP_STORE_ID=6757019626
# EXPO_PUBLIC_PLAY_STORE_ID=com.darshandelights.app
# EXPO_PUBLIC_APP_PUBLISHED=true
